{
  "name": "treepeek",
  "productName": "Treepeek",
  "version": "0.1.0-alpha.0",
  "description": "Review the Git worktrees beneath a folder, one window per folder.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Adhitya Yosua Sanjaya Andaria",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:lab": "electron-vite build --mode lab",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:core": "vitest run --project node tests/unit/core tests/unit/shared",
    "test:e2e": "playwright test",
    "notices": "bun ./build/generate-notices.ts",
    "licenses:check": "bun ./build/check-licenses.ts",
    "prepackage": "bun run notices",
    "package": "bun run build && electron-builder --dir",
    "prepackage:dmg": "bun run notices",
    "package:dmg": "bun run build && electron-builder --mac dmg"
  },
  "trustedDependencies": [
    "electron",
    "@parcel/watcher"
  ],
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@biomejs/biome": "2.6.6",
    "@electron/fuses": "2.1.3",
    "@pierre/diffs": "1.6.4",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tm-grammars": "1.32.22",
    "tm-themes": "1.12.12",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite": "7.3.7",
    "vitest": "5.1.0",
    "zustand": "5.0.16"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0"
  }
}
