{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../node_modules/.cache/tsc/tests",
    "rootDir": "..",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@renderer/*": ["../src/renderer/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../scripts/**/*.ts",
    "../build/**/*.ts",
    "../src/preload/types.d.ts"
  ],
  "references": [
    {
      "path": "../src/shared"
    },
    {
      "path": "../src/main"
    },
    {
      "path": "../src/core"
    },
    {
      "path": "../src/renderer"
    }
  ]
}
